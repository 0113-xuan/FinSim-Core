SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

AI_PROVIDER=gemini
AI_ENABLED=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# Production: independent fixed 32+ byte secret, shared across all workers/restarts.
# Missing uses a strong process-only key; a short configured key fails closed.
CAR_NEEDS_SIGNING_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

AI_API_KEY=
AI_MODEL=gpt-4.1-mini
